function AI_Bridge_Dump(tag)
	log("---- dump: " .. tostring(tag))
	try("game_time", function() return battle:game_time() end)
	local als = battle:alliances()
	local na = als:count()
	log("  alliances=" .. tostring(na))
	for a = 1, na do
		local al = als:item(a)
		if a == 1 and tag == "start" then log("  alliance methods: " .. methods(al)) end
		local arms = al:armies()
		for r = 1, arms:count() do
			local army = arms:item(r)
			if a == 1 and r == 1 and tag == "start" then log("  army methods: " .. methods(army)) end
			local units = army:units()
			log(string.format("  alliance %d army %d: %d Einheiten", a, r, units:count()))
			for u = 1, units:count() do
				local un = units:item(u)
				if a == 1 and r == 1 and u == 1 and tag == "start" then log("  unit methods: " .. methods(un)) end
				local line = string.format("    a%d r%d u%d", a, r, u)
				local function add(lbl, fn)
					local ok, v = pcall(fn)
					line = line .. " " .. lbl .. "=" .. (ok and tostring(v) or "ERR")
				end
				add("name", function() return un:name() end)
				add("pos", function() return vec(un:position()) end)
				add("bearing", function() return un:bearing() end)
				add("men", function() return un:number_of_men_alive() .. "/" .. un:initial_number_of_men() end)
				add("routing", function() return un:is_routing() end)
				add("moving", function() return un:is_moving() end)
				add("range", function() return un:missile_range() end)
				log(line)
			end
		end
	end
end

local function safe(tag)
	local ok, err = pcall(AI_Bridge_Dump, tag)
	if not ok then log("  dump '" .. tostring(tag) .. "' FEHLER: " .. tostring(err)) end
end

